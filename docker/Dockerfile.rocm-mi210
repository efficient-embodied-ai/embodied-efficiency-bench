# EmbodiedX (`embodied-efficiency-bench` v1.0) - AMD Instinct MI210 (64GB HBM2e, 1-GPU ROCm 6.3) Container
# Enforces single-GPU native uncapped execution (`ROCR_VISIBLE_DEVICES=0`, `HIP_VISIBLE_DEVICES=0`)
# under `CAP_SINGLE_CHIP` (`num_devices == 1`).

FROM rocm/pytorch:rocm6.3_ubuntu22.04_py3.10_pytorch_release_2.4.0

LABEL maintainer="EmbodiedX / CoRL 2026 Efficient Embodied AI Organizers"
LABEL description="AMD Instinct MI210 (64GB HBM2e, 1-GPU) ROCm 6.3 PyTorch / torch.compile / Composable Kernel runtime for EmbodiedX"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ROCR_VISIBLE_DEVICES=0 \
    HIP_VISIBLE_DEVICES=0 \
    CUDA_VISIBLE_DEVICES=0 \
    HSA_ENABLE_SDMA=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    rocm-smi-lib \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel && \
    pip install \
      numpy>=1.26.0 \
      pyyaml>=6.0 \
      pytest>=8.0.0

WORKDIR /workspace/embodied-efficiency-bench
COPY pyproject.toml README.md CONTRIBUTING.md ./
COPY eeb/ ./eeb/
COPY embodied_bench/ ./embodied_bench/
COPY runners/ ./runners/
COPY recipes/ ./recipes/
COPY leaderboard/ ./leaderboard/
COPY data/ ./data/

RUN pip install -e . && \
    (id -u eeb >/dev/null 2>&1 || useradd -m -u 10001 -s /bin/bash eeb) && \
    chown -R eeb:eeb /workspace/embodied-efficiency-bench

USER eeb
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python3 -c "import eeb, embodied_bench; assert eeb.__file__ and embodied_bench.__file__"

ENTRYPOINT ["eeb"]
CMD ["measure", "--recipe", "recipes/track2_wm_cosmos_predict25_amd_mi210.yaml", "--out", "/tmp/rocm_mi210_cosmos_predict25_report"]
